generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  
}

// 1. تحديد الرتب (مستخدم أو أدمن)
enum Role {
  USER
  ADMIN
}

model User {
  id            Int            @id @default(autoincrement())
  username      String         @unique
  email         String         @unique
  password      String
  phone         String         @unique
  
  // 2. إضافة الرتبة (تلقائياً الكل USER)
  role          Role           @default(USER)

  isVerified    Boolean        @default(false)
  otpCode       String?
  otpExpiresAt  DateTime?
  otpType       OtpType?
  
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

// 3. جدول الأفلام (للإضافة والحذف والتعديل)
model Movie {
  id           Int      @id @default(autoincrement())
  title        String
  description  String?  @db.Text
  posterUrl    String?
  videoUrl     String?
  genre        String[]
  rating       Float    @default(0.0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum OtpType {
  ACCOUNT_VERIFICATION
  PASSWORD_RESET
  TWO_FACTOR_AUTH
}

// Block token from logout 
model BlockedToken {
  id        String   @id @default(uuid())
  token     String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
}